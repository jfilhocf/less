        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ completed."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ concluída."
          }
        }
      }
    },
    "intent.complete.nothing": {
      "comment": "Resposta: nao havia tarefa para concluir",
      "localizations": {

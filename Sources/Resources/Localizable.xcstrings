            "value": "Instalar atalho"
          }
        }
      }
    },
    "shortcut.install.hint": {
      "comment": "O que acontece ao tocar em instalar",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens the Shortcuts app, you review the actions and tap Add. Just once."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o app Atalhos, você confere as ações e toca em Adicionar. Uma vez só."
          }
        }
      }
    },
    "shortcut.run": {
      "comment": "Botao que dispara o atalho",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start focus with the shortcut"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar foco pelo atalho"
          }
        }
      }
    },
    "shortcut.section.body": {
      "comment": "Explica a secao e por que o atalho existe",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shortcut that turns on the Work Focus, makes the screen black and white, and starts the block — all at once. iOS doesn't let any app do this on its own, so less hands you the shortcut ready-made."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um atalho que liga o Modo Foco Trabalho, deixa a tela em preto e branco e começa o bloco — tudo de uma vez. O iPhone não deixa nenhum app fazer isso sozinho, então o less entrega o atalho pronto."
          }
        }
      }
    },
    "shortcut.section.title": {
      "comment": "Titulo da secao do Atalho",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-tap focus"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foco com um toque"
          }
        }
      }
    },

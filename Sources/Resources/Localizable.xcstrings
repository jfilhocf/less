    "grayscale.openSettings": {
      "comment": "Botao que leva aos ajustes do app",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir Ajustes"
          }
        }
      }
    },
    "grayscale.section.body": {
      "comment": "Honestidade sobre o passo irredutivel",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shortcut turns on whichever filter is selected in your settings. Choosing grayscale is a manual step no app can do for you — but it's a one-time thing."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O atalho liga o filtro que estiver escolhido nos seus ajustes. Escolher a escala de cinza é um passo manual que nenhum app consegue fazer por você — mas é uma vez só."
          }
        }
      }
    },
    "grayscale.section.title": {
      "comment": "Titulo da secao do filtro de cor",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Black and white"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preto e branco"
          }
        }
      }
    },
    "grayscale.step.1": {
      "comment": "Passo 1",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings and tap Accessibility"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra os Ajustes e toque em Acessibilidade"
          }
        }
      }
    },
    "grayscale.step.2": {
      "comment": "Passo 2",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Under VISION, tap Display & Text Size"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em VISÃO, toque em Tela e Tamanho do Texto"
          }
        }
      }
    },
    "grayscale.step.3": {
      "comment": "Passo 3",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scroll to Color Filters and tap it"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Role até Filtros de Cor e toque"
          }
        }
      }
    },
    "grayscale.step.4": {
      "comment": "Passo 4",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Color Filters — the filter list appears below"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue a chave Filtros de Cor — a lista de filtros aparece abaixo"
          }
        }
      }
    },
    "grayscale.step.5": {
      "comment": "Passo 5",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Grayscale and drag Intensity all the way right"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em Tons de Cinza e arraste a Intensidade toda para a direita"
          }
        }
      }
    },
    "grayscale.step.6": {
      "comment": "Passo 6",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn the switch off. Your choice is saved — now the shortcut goes straight to black and white."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligue a chave. A escolha fica gravada — agora o atalho liga direto em preto e branco."
          }
        }
      }
    },
    "grayscale.warning": {
      "comment": "Aviso quando o filtro ativo nao e grayscale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The color filter is on, but not black and white. Choosing Grayscale is a one-time step in Settings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O filtro de cor está ligado, mas não em preto e branco. Escolher Tons de Cinza é um passo único nos Ajustes."
          }
        }
      }
    },
    "intent.complete.description": {
      "comment": "Descricao da acao no Atalhos",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completes the task currently in focus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclui a tarefa que está em foco."
          }
        }
      }
    },
    "intent.complete.done %@": {
      "comment": "Resposta da Siri ao concluir, com o titulo da tarefa",
